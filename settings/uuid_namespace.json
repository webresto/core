{
  "key": "UUID_NAMESPACE",
  "type": "string",
  "name": "UUID Namespace",
  "description": "A UUID: 8-4-4-4-12 lowercase hex digits",
  "jsonSchema": {
    "type": "string",
    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
    "minLength": 36,
    "maxLength": 36
  },
  "isRequired": true,
  "restartRequired": true
}
