{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": ".",
    "outDir": "./.tsc-models-out",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "noEmitOnError": false
  },
  "include": ["models/*.ts"],
  "exclude": ["node_modules", "models/*.d.ts"]
}
