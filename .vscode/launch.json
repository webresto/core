{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Test",
      "stopOnEntry": true,
      "runtimeExecutable": null,
      "preLaunchTask": "tsc: build - tsconfig.debug.json",
      "program": "${workspaceFolder}/node_modules/mocha/bin/_mocha",
      "args": [
        "-r",
        "tsx/cjs",
        "-r",
        "${workspaceFolder}/test/places/support/sails.ts",
        "${workspaceFolder}/test/places/integration/**/*.test.ts",
        "--exit",
        "--timeout=600000",
        "--grep=111"
      ],
      "sourceMaps": true,
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}